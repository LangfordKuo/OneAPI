# OneAPI environment template.
# The setup wizard writes <ONEAPI_DATA_DIR>/.env automatically on first run.
# A .env in the working directory or data directory is loaded on startup;
# existing process environment variables always take precedence.

# Server
ONEAPI_ADDR=0.0.0.0:3000

# Data directory (SQLite database, master.key and generated .env live here)
ONEAPI_DATA_DIR=./data

# Optional explicit SQLite URL; defaults to sqlite file under ONEAPI_DATA_DIR
# ONEAPI_DATABASE_URL=sqlite:///absolute/path/oneapi.db

# Logging
ONEAPI_LOG_LEVEL=info
# ONEAPI_LOG_JSON=1

# Optional headless bootstrap. If ONEAPI_ADMIN_PASSWORD is omitted, the web
# setup page creates the first admin instead.
# ONEAPI_ADMIN_USER=admin
# ONEAPI_ADMIN_PASSWORD=replace-with-a-strong-password

# Master key for encrypting upstream API keys at rest.
# If unset, a key file is generated under the data directory.
# ONEAPI_SECRET=replace-with-a-long-random-string

# Set to true when serving over HTTPS
ONEAPI_COOKIE_SECURE=false
